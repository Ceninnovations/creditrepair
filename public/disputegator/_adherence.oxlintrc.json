{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/credit/**",
              "components/forms/**",
              "ui_kits/disputegator-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Plus Jakarta Sans))/i]",
        "message": "Font not provided by the design system. Available: Plus Jakarta Sans."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|icon|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, icon, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:high|medium|low|positive|fair|strong|moderate|weak|neutral)$/]",
        "message": "<Badge> tone must be one of 'high' | 'medium' | 'low' | 'positive' | 'fair' | 'strong' | 'moderate' | 'weak' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BureauInfo'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|name|abbr|color|key|ref|className|style|children)$/]",
        "message": "<BureauInfo> doesn't accept that prop. Declared props: key, name, abbr, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|icon|iconRight|loading|disabled|type|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, icon, iconRight, loading, disabled, type, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|ghost|outline)$/]",
        "message": "<Button> variant must be one of 'primary' | 'ghost' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|accent|pad|className|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, accent, pad, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CreditDonut'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|size|label|color|key|ref|className|style|children)$/]",
        "message": "<CreditDonut> doesn't accept that prop. Declared props: value, size, label, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|stroke|fill|className|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, stroke, fill, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute[name.name='name'] > Literal[value!=/^(?:shield|check|user|key|file|fileText|uploadCloud|lock|calendar|eye|eyeOff|external|refresh|sparkle|checkCircle|xCircle|info|chevronDown|chevronRight|arrowRight|trending|gauge|copy|download|print|close|layers|alert|hash|percent|scale|home|clock|trash|checkSquare|dollarSign|wallet|creditCard|settings|helpCircle|gem|briefcase|plus)$/]",
        "message": "<Icon> name must be one of 'shield' | 'check' | 'user' | 'key' | 'file' | 'fileText' | 'uploadCloud' | 'lock' | 'calendar' | 'eye' | 'eyeOff' | 'external' | 'refresh' | 'sparkle' | 'checkCircle' | 'xCircle' | 'info' | 'chevronDown' | 'chevronRight' | 'arrowRight' | 'trending' | 'gauge' | 'copy' | 'download' | 'print' | 'close' | 'layers' | 'alert' | 'hash' | 'percent' | 'scale' | 'home' | 'clock' | 'trash' | 'checkSquare' | 'dollarSign' | 'wallet' | 'creditCard' | 'settings' | 'helpCircle' | 'gem' | 'briefcase' | 'plus'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|icon|type|error|reveal|value|onChange|placeholder|style|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, icon, type, error, reveal, value, onChange, placeholder, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScoreCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:bureau|score|rating|util|negItems|key|ref|className|style|children)$/]",
        "message": "<ScoreCard> doesn't accept that prop. Declared props: bureau, score, rating, util, negItems."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|onChange|options|placeholder|error|style|key|ref|className|style|children)$/]",
        "message": "<Select> doesn't accept that prop. Declared props: label, value, onChange, options, placeholder, error, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
